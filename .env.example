# ==============================================================================
# Yuvnix Environment Variables (Client-Side)
# ==============================================================================
# IMPORTANT: Only variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put Supabase Service Role Key or database root passwords in this file or
# in any client-facing code.
# ==============================================================================

# Supabase Project URL (e.g. https://your-project.supabase.co)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase Public Anon Key (safe for browser client with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Application Base URL (for redirect URLs during OAuth)
VITE_APP_URL=http://localhost:5173

# Optional: Environment flag ('development' | 'staging' | 'production')
VITE_APP_ENV=development

# Optional: Google Maps API Key (for Google Places search & landmarks)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key
